@{
    ViewBag.Title = "Xem Quy Tắc Ứng Xử";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@using E_Learning.Models
@model List<NoiQuyUXKQView>

<div class="app-main__outer">
    <div class="app-main__inner">
        @foreach (var item in Model)
        {
            <div class="app-page-title">
                <div class="page-title-wrapper">
                    <div class="page-title-heading">
                        <div class="page-title-icon">
                            <i class="pe-7s-notebook icon-gradient bg-grow-early"></i>
                        </div>
                        <div>
                            @item.MaND
                            <div class="page-title-subheading"></div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="tab-content">
                <div class="row">
                    <div class="col-lg-12">
                        <div class="main-card mb-3 card">
                            <div class="card-body">
                                <div class="row" style="padding: 38px 16px;">
                                    <div class="col-lg-5" style="">
                                        <div class="">
                                            <h5 class="card-title">Hướng Dẫn Học Tập</h5>
                                            <ul>
                                                <li><p>Học viên phải xem hết video bài học và nhấn nút <strong>"Hoàn thành"</strong> mới <strong>ghi nhận hoàn thành bài học.</strong></p></li>
                                                <li><p>Học viên không thể tua nhanh video, khi video bị sự cố hoặc lỗi mạng học viên nhấn <strong>pause/play</strong> để tiếp tục.</p></li>
                                                <li><p>Khi đang học online nếu học viên thoát khi chưa <strong>"Hoàn thành"</strong> bài học thì phải vào học lại từ đầu.</p></li>
                                                <li><p>Học viên có thể xem lại nội dung bài học trong thời gian khóa học đang diễn ra.</p></li>
                                                <li><p>Sau khi xem video và tài liệu, học viên cần phải hoàn thành <strong>bài kiểm tra trực tuyến</strong>.</p></li>
                                            </ul>
                                            <div class="widget-content">
                                                <div class="widget-content-wrapper" style="padding: .5rem 0 0;">
                                                    <div class="widget-content-left"><strong>Nội dung: </strong></div>
                                                    <div class="widget-content-right font-weight-bold">@item.NoiDung.ToUpper()</div>
                                                </div>
                                                <div class="widget-content-wrapper" style="padding: .5rem 0 0;">
                                                    <div class="widget-content-left"><strong>File Tài Liệu: </strong></div>
                                                    <div class="widget-content-right">
                                                        @if (item.FileDinhKem != null)
                                                        {
                                                            if (item.XNHTFile != 1)
                                                            {
                                                                <a id="file_@item.IDND" href="@Url.Action("CompleteFile", "QTUXUser", new {id = @item.IDND, link = @item.FileDinhKem})" target="_blank">
                                                                    <span style="color:red;"><i class="fa fa-file-pdf-o" aria-hidden="true"></i></span> Xem tài liệu
                                                                </a>
                                                                                        <script>
                                                                $(document).ready(function () {
                                                                    $('#file_@item.IDND').click(function (e) {
                                                                        e.preventDefault();
                                                                        window.open($(this).attr('href'), '_blank');
                                                                        window.location.reload();
                                                                    });
                                                                });
                                                                </script>
                                                            }
                                                            else
                                                            {
                                                                <a href="@item.FileDinhKem" target="_blank"><span style="color:green;"><i class="fa fa-file-pdf-o" aria-hidden="true"></i></span> Tài liệu đã xem</a>
                                                            }
                                                        }
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="col-lg-7" style="">
                                        <div class="" style="width: 100%; height: auto;">
                                            @if (item.XNHT != 1)
                                            {
                                                <video id="videoPlayer" width="100%" poster="@item.ImageND" controls controlsList="nodownload" preload="true">
                                                    <source src="@item.VideoND" type="video/mp4">
                                                    Trình duyệt của bạn không hỗ trợ thẻ video.
                                                </video>
                                            }
                                            else
                                            {
                                                <video width="100%" poster="@item.ImageND" controls controlsList="nodownload" preload="true">
                                                    <source src="@item.VideoND" type="video/mp4">
                                                    Trình duyệt của bạn không hỗ trợ thẻ video.
                                                </video>
                                            }
                                        </div>
                                    </div>

                                    <div class="" style="position: absolute;bottom: 14px;right: 30px">
                                        @if (@item.XNHT != 1)
                                        {
                                            using (Html.BeginForm("CompleteLesson", "QTUXUser", FormMethod.Post))
                                            {
                                                <input type="hidden" name="id" value="@item.IDND" />

                                                <button type="submit" class="btn-transition btn btn-success">
                                                    Hoàn thành
                                                </button>
                                            }
                                            @*<a href="@Url.Action("CompleteLesson" , "QTUXUser" , new { id = @item.IDND })">
                                                <button class="btn-transition btn btn-success">Hoàn thành</button>
                                            </a>*@
                                        }
                                        else
                                        {
                                            <a href="@Url.Action("ListQTUX", "QTUXView")">
                                                <button class="btn-transition btn btn-info">Quay lại</button>
                                            </a>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    <div class="app-wrapper-footer">
        <div class="app-footer">
            <div class="app-footer__inner"></div>
        </div>
    </div>
</div>
