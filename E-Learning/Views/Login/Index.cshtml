@{
    Layout = null;
}
@model E_Learning.Models.LoginValidation
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
    <meta name="description" content="" />
    <meta name="author" content="" />
    <title>Đăng nhập</title>
    <link href="~/Content/main.css" rel="stylesheet" />
    <script src="~/Content/assets/plotly-latest.min.js"></script>
    <script src="~/Content/jquery-3.0.0.min.js"></script>
    <script src="~/Content/bootstrap.min.js"></script>
</head>
@if (TempData["msglg"] != null)
{
    @Html.Raw(TempData["msglg"])
}

<body class="bg-login">

    <div class="container" style="height:100%">
        <div class="main-content">
            <div class="content-centered">

                @*Form Login*@

                <div class="card shadow-lg border-0 rounded-lg" style="background-color: rgba(0, 51, 102, 0.7) !important">
                    <div class="card-header">
                        <img src="~/Content/assets/images/logo-inverse.png"
                            style="width:100%; height:auto; max-width:230px; margin: 0 auto;" />
                    </div>
                    <div class="card-body">

                        <p class="text-center font-weight-light" style="color: white;">Phần mềm đào tạo trực tuyến E-Learning</p>

                        @using (Html.BeginForm("LoginUser", "Login", new { id = "myForm" }))
                        {
                            <h5 id="formTitle" class="text-center mb-3" style="color: white;">Đăng nhập E-Learning</h5>
                            <div class="form-group">
                                <div class="input-group">
                                    <div class="input-group-prepend">
                                        <span class="input-group-text">
                                            <i class="fas fa-id-badge"></i>
                                        </span>
                                    </div>
                                    @Html.TextBoxFor(m => m.MaNV, new { @class = "form-control", @placeholder = "Mã Nhân Viên" })
                                </div>
                                @Html.ValidationMessageFor(m => m.MaNV, "", new { @class = "text-danger" })
                                <div id="show_error_user"></div>
                            </div>

                            <div class="form-group">
                                <div class="input-group">
                                    <div class="input-group-prepend">
                                        <span class="input-group-text">
                                            <i class="fas fa-lock"></i>
                                        </span>
                                    </div>
                                    @Html.PasswordFor(m => m.MatKhau, new { @class = "form-control", @placeholder = "Mật khẩu" })
                                </div>
                                @Html.ValidationMessageFor(m => m.MatKhau, "", new { @class = "text-danger" })
                                <div id="show_error_pass"></div>
                            </div>

                            <div class="form-group">
                                <button id="LoginUser" type="submit"
                                        class="form-control btn btn-primary submit px-3">
                                    <strong>Đăng Nhập</strong>
                                </button>
                            </div>

                            <!-- Nút chuyển đổi chế độ đăng nhập -->
                            <div class="form-group">
                                <button type="button" id="toggleLoginMode"
                                        class="form-control btn btn-outline-secondary submit px-3">
                                    <strong style="color: white;">Đăng nhập bằng Time365</strong>
                                </button>
                            </div>

                            <div class="form-group">
                                <div class="custom-control custom-checkbox">
                                    <input class="custom-control-input" id="rememberPasswordCheck" type="checkbox" />
                                    <label class="custom-control-label" for="rememberPasswordCheck" style="color: white;">Nhớ tài khoản</label>
                                </div>
                            </div>
                            <div class="form-group text-center">
                                <a class="app-Android" target="_blank"
                                   href="https://apps.apple.com/us/app/e-learning-hpdq/id6472882908">
                                    <img alt=""
                                         style="max-height:34px" title="Tải app IOS"
                                         src="~/Content/assets/images/AppStore.png">
                                </a>
                                <a class="app-Android" target="_blank"
                                   href="https://play.google.com/store/apps/details?id=com.mysticacademy.app">
                                    <img alt=""
                                         style="max-height:34px" title="Tải app IOS"
                                         src="~/Content/assets/images/GooglePlay.png">
                                </a>
                            </div>
                            <div class="form-group text-center mt-2">
                                <div style="color:white; font-weight:600;">
                                    Lượt truy cập
                                </div>

                                <small style="color: white;">
                                    Hôm nay: <strong>@ViewBag.DailyVisits</strong> |
                                    Tuần này: <strong>@ViewBag.WeeklyVisits</strong> |
                                    Tháng này: <strong>@ViewBag.MonthlyVisits</strong>
                                </small>

                                <div>
                                    <small style="color:white;">
                                        Tổng: <strong>@ViewBag.TotalVisits</strong>
                                    </small>
                                </div>
                            </div>
                        }

                    </div>

                </div>

                @*End Form Login*@

            </div>
        </div>
        <footer class="">
            <div class="">
                <div class="">
                    <div class="text-c">Copyright &copy; @DateTime.Now.Year Phòng Công nghệ thông tin và Chuyển đổi số<br /> Công ty CP
                        Thép Hòa Phát Dung Quất </div>
                </div>
            </div>
        </footer>

    </div>


    @if (TempData["msg"] != null)
    {
        Html.Raw(TempData["msg"]);
    }
    @{
        Html.RenderAction("Details", "Notification");
    }
</body>

</html>
<script>
    // Biến theo dõi chế độ đăng nhập hiện tại
    var isTime365Mode = false;

    // Xử lý chuyển đổi chế độ đăng nhập
    $("#toggleLoginMode").on('click', function (e) {
        e.preventDefault();
        isTime365Mode = !isTime365Mode;

        if (isTime365Mode) {
            // Chuyển sang chế độ Time365
            $("#formTitle").text("Đăng nhập bằng Time365");
            $("#toggleLoginMode").html("<strong>Quay lại Đăng nhập E-Learning</strong>");
            $("#toggleLoginMode").removeClass("btn-outline-secondary").addClass("btn-warning");
        } else {
            // Chuyển về chế độ E-Learning
            $("#formTitle").text("Đăng nhập E-Learning");
            $("#toggleLoginMode").html("<strong>Đăng nhập bằng Time365</strong>");
            $("#toggleLoginMode").removeClass("btn-warning").addClass("btn-outline-secondary");
        }
    });

    // Xử lý Enter key
    $("#MatKhau").keyup(function (event) {
        if (event.keyCode == 13) {
            $("#LoginUser").click();
        }
    });

    // Xử lý sự kiện khi click nút Đăng nhập
    $("#LoginUser").on('click', function (e) {
        // Clear thông báo lỗi trước đó
        $('#show_error_user').html('');
        $('#show_error_pass').html('');

        var maNV = $('#MaNV').val();
        var matKhau = $('#MatKhau').val();

        if (maNV == "") {
            $('#show_error_user').html('Nhập mã nhân viên!');
            $('#show_error_user').css('color', 'red');
            return false;
        }
        if (matKhau == "") {
            $('#show_error_pass').html('Nhập mật khẩu!');
            $('#show_error_pass').css('color', 'red');
            return false;
        }
        return true;
    });
</script>