@{
    ViewBag.Title = "Kết Quả Quy Tắc Ứng Xử";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@using E_Learning.Models
@using E_Learning.ModelsQTUX
@model PagedList.IPagedList<ResultQTUXView>
@using PagedList.Mvc

<link href="~/Content/assets/Chonse/chosen.jquery.js" rel="stylesheet" />
<link href="~/Content/assets/Chonse/chosen.css" rel="stylesheet" />

<div class="app-main__outer">
    <div class="app-main__inner">
        <div class="app-page-title">
            <div class="page-title-wrapper">
                <div class="page-title-heading">
                    <div class="page-title-icon">
                        <i class="pe-7s-id icon-gradient bg-grow-early"></i>
                    </div>
                    <div>
                        Kết Quả Quy Tắc Ứng Xử
                        <div class="page-title-subheading"></div>
                    </div>
                </div>
            </div>
        </div>

        <div class="tab-content">
            <div class="row">
                <div class="card col-lg-12">
                    <div class="card-header">
                        <div class="col-md-12 col-lg-12">
                            <div class="row">
                                <div class="col-md-2">
                                    <input type="text" id="txtsearch" name="" placeholder="Nhập mã nhân viên" class="form-control position-relative" style="top:-5px" value="@ViewBag.search">
                                </div>
                                <div class="col-md-4">
                                    @Html.DropDownList("LisNV", null, "--Nhân viên--", new { id = "LisNV", @class = "form-control ", @style = "width:100%", })
                                </div>
                                <div class="col-md-4">
                                    @Html.DropDownList("IDPB", null, "--Phòng Ban/Bộ phận--", new { id = "IDPB", @class = "form-control ", @style = "width:100%", })
                                </div>
                                <div class="col-md-2 form-control">
                                    <button class="btn btn-primary" id="btn-search"><i class="fa fa-search"></i> Tìm kiếm</button>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table table-bordered table-hover" id="table" width="100%" cellpadding="0">
                                <thead class="thead-light">
                                    <tr>
                                        <th class="text-center" width="30px">STT</th>
                                        <th class="text-center">Thao tác</th>
                                        <th class="text-center">Mã Nhân viên</th>
                                        <th class="text-center">Họ Tên</th>
                                        <th class="text-center">Phòng Ban</th>
                                        @foreach (var hd in ViewBag.ColumHeader)
                                        {
                                            <th class="text-center">@hd</th>
                                        }
                                    </tr>
                                </thead>
                                <tbody>
                                    @{
                                        int pageno = (int)Model.PageNumber;
                                        int itemperpage = (int)Model.PageSize;
                                        int RowNo = ((pageno - 1) * itemperpage) + 1;
                                    }
                                    @foreach (var item in Model)
                                    {
                                        <tr>
                                            <td class="text-center">@RowNo@{RowNo++;}</td>
                                            <td class="text-center">
                                                <a class="fas fa-eye icon_action" title="Chi tiết" href="@Url.Action("ResultView", "ResultQTUX", new { IDNV = item.IDNV })">
                                                </a>
                                            </td>
                                            <td>@item.MaNV</td>
                                            <td>@item.HoTen</td>
                                            <td>@item.PhongBan</td>
                                            @foreach (var kq in item.ListKQuaQTUX)
                                            {
                                                <td class="text-center">
                                                    @if (kq.TinhTrang == 1)
                                                    {
                                                        <span class="text-success">✓</span>
                                                    }
                                                </td>
                                            }
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        <div class="pager float-right">
                            @Html.PagedListPager(Model, page => Url.Action("Index", "ResultQTUX", new { page, IDNV = Request.QueryString["IDNV"], IDPB = Request.QueryString["IDPB"] }))
                            <span class="pageoff">Trang @(Model.PageCount < Model.PageNumber ? 0 : Model.PageNumber) / @Model.PageCount</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="app-wrapper-footer">
        <div class="app-footer">
            <div class="app-footer__inner"></div>
        </div>
    </div>
</div>

<script type="text/javascript">
    //$("#LisNV").chosen({
    //    width: "100%",
    //});
    //$("#IDPB").chosen({
    //    width: "100%",
    //});
    $("#btn-search").on('click', function () {
        var search = $('#txtsearch').val();
        window.location.href = '@Url.Action("Index", "ResultQTUX")?search=' + search + "&IDNV=" + $('#LisNV').val() + "&IDPB=" + $('#IDPB').val();
    });
</script>
