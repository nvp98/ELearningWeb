
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@using E_Learning.Models
@model List<KhungNangLucValidation>
@using PagedList.Mvc

<link href="~/Content/assets/css/PagedList.css" rel="stylesheet" />
<script src="~/Content/assets/Chonse/chosen.jquery.js"></script>
<link href="~/Content/assets/Chonse/chosen.css" rel="stylesheet" />

@if (TempData["msgSuccess"] != null)
{
    @Html.Raw(TempData["msgSuccess"])
}
@if (TempData["msgError"] != null)
{
    @Html.Raw(TempData["msgError"])
}
<style>
    input[type="checkbox"] {
        zoom: 1.3;
    }
</style>
@{
    ELEARNINGEntities db = new ELEARNINGEntities();
    int idvt = (int)ViewBag.SLIDVT;
    var listduyet = db.KNL_PheDuyetKNL.Where(x => x.ID_NguoiDuyet == MyAuthentication.ID && x.TinhTrang == 0 && x.IDVT == idvt).ToList();
}

<div class="app-main__outer">
    <div class="app-main__inner">

        <div class="app-page-title mb-0">
            <div class="page-title-wrapper">
                <div class="page-title-heading">
                    <div class="page-title-icon">
                        <i class="pe-7s-id icon-gradient bg-grow-early">
                        </i>
                    </div>
                    <div>
                        Tạo mới Yêu cầu năng lực <br />
                        Lưu ý khi cập nhật nội dung KNL:
                        <br /> - Tick chọn không đánh giá nếu bạn muốn xóa 1 dòng năng lực.
                        <br /> - Sửa nội dung sẽ thay đổi cả lịch sử đánh giá, nên chỉ sửa khi có thay đổi nhỏ, và thay đổi lớn về bản chất thì nên tạo năng lực mới (không sửa).
                        <div class="page-title-subheading">
                        </div>
                    </div>

                </div>

            </div>
            @if (listduyet.Count == 0 || true)
            {
                <div class="col-md-12">
                    <button type="button" id="btn-trinhky" class="btn btn-success m-l-auto"><i class="fa fa-plane">&nbsp;</i>&nbsp;Trình ký Bảng Khung năng lực </button>
                    <div class=" modal fade" id="myModaleTK" role="dialog" data-url='@Url.Action("TrinhKyBangKNL", "FPosition", new { IDVT = ViewBag.SLIDVT, IDPB = ViewBag.PBIDD })'></div>
                    <script type="text/javascript">
                        $("#btn-trinhky").click(function () {
                            var url = $('#myModaleTK').data('url');
                            $.get(url, function (data) {
                                $("#myModaleTK").html(data);
                                $("#ModalTitle").html("Trình ký Bảng Khung năng lực");
                                $("#myModaleTK").modal('show');
                            });
                        });
                    </script>
                </div>
            }
        </div>



        <div class="card mb-4">
            <div class="card-body">
                <div class="" id="formF">
                    <div class="modal-content">
                        <div class="modal-header d-none">
                            <h5 id="ModalTitle"></h5>
                        </div>
                        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                        <div class="modal-body">
                            @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                            <fieldset id="SubmitForm">
                                <div class="row">
                                    <div class="form-group col-md-4">
                                        <label class="font-weight-bold mb-1">Bộ Phận</label>
                                        @Html.DropDownList("IDPB", null, null, new { id = "IDPB", @class = "form-control marginTB5", @style = "width:100%", })
                                    </div>
                                    <div class="form-group col-md-7">
                                        <label class="font-weight-bold mb-1">Vị Trí Khung Năng Lực</label>
                                        @Html.DropDownList("IDVT", null, null, new { id = "IDVT", @class = "form-control marginTB5", @style = "width:100%", })
                                    </div>

                                    <div id="list_vt" style="width:100%" class="row form-group col-md-12">
                                        <div class="table-responsive col-md-12">
                                            <table class="table table-bordered table-hover" id="table" width="100%" cellpadding="0">
                                                <thead class="thead-light">
                                                    <tr>
                                                        <th class="text-center" width="100px">Thao tác</th>
                                                        <th class="text-center">Yêu cầu năng lực</th>
                                                        <th class="text-center" width="100px">Định mức</th>
                                                        <th class="text-center small font-weight-bold" width="100px">Không đánh giá</th>
                                                        <th class="text-center" width="100px">Thứ Tự</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    <tr id="nl-chung"><th colspan="5" class="font-weight-bold font-size-lg">I. Năng lực chung</th></tr>
                                                    <tr id="nl-chuyenmon"><th colspan="5" class="font-weight-bold font-size-lg">II. Năng lực chuyên môn</th></tr>
                                                    <tr id="cmon">
                                                        <th colspan="5" class="font-weight-bold font-size-lg">
                                                            <button id="add-new-chuyenmon" type="button" class="btn btn-light border border-white"><i class="fas fa-plus"></i></button>
                                                        </th>
                                                    </tr>
                                                    <tr id="nl-quanly"><th colspan="5" class="font-weight-bold font-size-lg">III. Năng lực quản lý</th></tr>
                                                </tbody>
                                            </table>
                                        </div>
                                    </div>
                                </div>

                                <div class="btn-margin-top text-center ">
                                    @if (MyAuthentication.IDQuyen != 9 && MyAuthentication.IDQuyen != 10)
                                    {
                                        <input type="button" value="Cập nhật" class="btn btn-primary pull-right " id="btn-save" />
                                        <div class="btn btn-danger pull-right button_cancel mr-1">
                                            <a class="text-light" title="Chi tiết" href="@Url.Action("Index", "FPosition")"
                                               onclick="return confirm('Hủy cập nhật nội dung')">
                                                Hủy
                                            </a>
                                        </div>
                                    }
                                </div>
                            </fieldset>

                        </div>
                    </div>
                </div>


                <script defer>

                var idVT = '@ViewBag.SLIDVT';
                var idPB = '@ViewBag.PBIDD';
                    var loaiKNLs = @Html.Raw(Json.Encode((List<LoaiKNL>)ViewBag.IDLoaiNL));
                    function reloadLoaiKNLs() {
                        fetch(`/FPosition/GetLoaiKNLs?id=${idVT}`)
                            .then(res => res.json())
                            .then(data => {
                                loaiKNLs = data; // Gán lại biến loaiKNLs phía JS
                                //console.log('Reloaded LoaiKNL:', loaiKNLs);
                            })
                            .catch(err => console.error('Lỗi load:', err));
                    }
                    function renderInitialTbody() {
                        const tbody = document.querySelector('#table tbody');
                        $('#table tbody').empty();
                        const htmlbody = `<tr id="nl-chung"><th colspan="5" class="font-weight-bold font-size-lg">I. Năng lực chung</th></tr>
                        <tr id="nl-chuyenmon"><th colspan="5" class="font-weight-bold font-size-lg">II. Năng lực chuyên môn</th></tr>
                        <tr id="cmon">
                            <th colspan="5" class="font-weight-bold font-size-lg">
                                <button id="add-new-chuyenmon" type="button" class="btn btn-light border border-white"><i class="fas fa-plus"></i></button>
                            </th>
                        </tr>
                        <tr id="nl-quanly"><th colspan="5" class="font-weight-bold font-size-lg">III. Năng lực quản lý</th></tr>`;
                        $('#table tbody').append(htmlbody);
                    }
                    function loadData() {
                        reloadLoaiKNLs();
                        $.ajax({
                            url: '/FPosition/GetKhungNangLucAsync',
                            type: 'GET',
                            data: { id: idVT },
                            success: function (data) {
                                // Reload tbody
                                renderInitialTbody()
                                let htmlChung = '';
                                let htmlChuyenMon = '';
                                let htmlQLy = '';
                                data.forEach((item, index) => {
                                    if (item.IDLoaiNL == 1) {
                                        htmlChung += `
                                           <tr>
                                               <td class="text-center"></td>
                                               <td>
                                                   <textarea readonly rows="1" class="form-control txt-tennl" data-IDVT="${item.IDVT}" data-IDLoaiNL="${item.IDLoaiNL}" data-IDPB="${item.IDPB}"  data-idnl="${item.IDNL}">${item.TenNL}</textarea>
                                               </td>
                                               <td style="width:100px">
                                                   <input type="text" ${item.IsDanhGia != 1 ? 'readonly' : ''} class="form-control dinhmuc" maxlength="1" value="${item.DinhMuc ?? ''}" />
                                               </td>
                                               <td class="text-center" style="width:100px">
                                                   <input type="checkbox" class="danhgia" ${item.IsDanhGia != 1 ? 'checked' : ''} />
                                               </td>
                                               <td></td>
                                           </tr>`;
                                    }
                                    else if (item.IDLoaiNL == 2) {
                                        htmlQLy += `
                                           <tr>
                                              <td class="text-center"></td>
                                               <td>
                                                   <textarea readonly rows="1" class="form-control txt-tennl" data-IDVT="${item.IDVT}" data-IDLoaiNL="${item.IDLoaiNL}" data-IDPB="${item.IDPB}"  data-idnl="${item.IDNL}">${item.TenNL}</textarea>
                                               </td>
                                              <td style="width:100px">
                                                  <input type="text" ${item.IsDanhGia != 1 ? 'readonly' : ''} class="form-control dinhmuc" maxlength="1" value="${item.DinhMuc ?? ''}" />
                                              </td>
                                              <td class="text-center" style="width:100px">
                                                  <input type="checkbox" class="danhgia" ${item.IsDanhGia != 1 ? 'checked' : ''} />
                                              </td>
                                              <td></td>
                                          </tr>`;
                                    }
                                });
                                loaiKNLs.forEach((loai, index) => {
                                    htmlChuyenMon += `
                                  <tr class="text-center" id="nhom_${loai.IDLoai}">
                                      <th class="small font-weight-bold">
                                          <button class="btn fa fa-trash icon_action btn-delete-loaiKNL" data-id="${loai.IDLoai}">
                                          </button>
                                          Chuyên môn
                                      </th>
                                      <th colspan="3" class="font-weight-bold font-size-lg flexible-wrap">
                                          <input type="text" class="form-control font-weight-bold txt-tennhomnl"
                                                 value="${loai.TenLoai}"  data-idloai="${loai.IDLoai}">
                                      </th>
                                      <td style="width:100px" class="text-center">
                                          <input type="number" class="form-control font-weight-bold"
                                                 value="${loai.OrderBy}">
                                      </td>
                                  </tr>`;
                                    data.forEach((item, index) => {
                                        if (item.IDLoaiNL == loai.IDLoai) {
                                            htmlChuyenMon += `
                                                <tr id="row_${item.IDNL}" class="nhom_${loai.IDLoai}">
                                                  <td class="text-center">
                                                      <button class="btn fa fa-trash icon_action btn-delete-knl" data-id="${item.IDNL}">
                                                      </button>
                                                  </td>
                                                   <td>
                                                       <textarea rows="1" class="form-control txt-tennl" data-IDVT="${item.IDVT}" data-IDLoaiNL="${item.IDLoaiNL}" data-IDPB="${item.IDPB}"  data-idnl="${item.IDNL}">${item.TenNL}</textarea>
                                                   </td>
                                                  <td style="width:100px">
                                                      <input type="text" ${item.IsDanhGia != 1 ? 'readonly' : ''} class="form-control dinhmuc" maxlength="1" value="${item.DinhMuc ?? ''}" />
                                                  </td>
                                                  <td class="text-center" style="width:100px">
                                                      <input type="checkbox" class="danhgia" ${item.IsDanhGia != 1 ? 'checked' : ''} />
                                                  </td>
                                                  <td><input type="number" class="form-control font-weight-bold sapxep" value="${item.OrderBy}">
                                                  </td>
                                              </tr>`;
                                        }
                                    });
                                    // Thêm +
                                    htmlChuyenMon += `
                                      <tr id="add-row-${loai.IDLoai}">
                                          <td colspan='1'></td>
                                              <td colspan='3' class='font-weight-bold font-size-lg'>
                                              <button type='button' class='btn btn-light border border-white btn-add-cmon' data-idloai="${loai.IDLoai}"><i class='fas fa-plus'></i></button>
                                          </td>
                                      </tr>
                                      `;
                                })
                                // Chèn HTML sau thẻ có id="nl-chung"
                                $('#nl-chung').after(htmlChung);
                                $('#nl-chuyenmon').after(htmlChuyenMon);
                                $('#nl-quanly').after(htmlQLy);
                            },
                            error: function (xhr, status, error) {
                                console.error("Lỗi khi gọi API:", error);
                                alert("Không tải được dữ liệu năng lực.");
                            }
                        });
                    }
                $(document).ready(function () {
                    loadData();
                });
                //get data KNL
                    function collectKNLData() {
                        let data = [];

                        $('tr').each(function () {
                            const tenLoaiNL = $(this).find('.txt-tennhomnl').val();
                            const tenNL = $(this).find('.txt-tennl').val();
                            const idNL = $(this).find('.txt-tennl').data('idnl');
                            const idPhongBan = $(this).find('.txt-tennl').data('idpb');
                            const idLoaiNL = $(this).find('.txt-tennl').data('idloainl') || $(this).find('.txt-tennhomnl').data('idloai');
                            const dinhMuc = $(this).find('.dinhmuc').val();
                            const danhGia = $(this).find('.danhgia').is(':checked');
                            const Orderby = $(this).find('.sapxep').val();
                            //if (idNL) {

                            //}
                            data.push({
                                IDNL: idNL || 0,
                                TenNL: tenNL,
                                DinhMuc: parseInt(dinhMuc),
                                DanhGia: danhGia,
                                IDPhongBan: idPhongBan,
                                IDLoaiNL: idLoaiNL,
                                TenLoaiNL: tenLoaiNL,
                                OrderBy: Orderby,
                                IsDuyet: null,
                                IDVT: idVT,
                                IDPB: idPB,
                            });
                        });

                        return data;
                    }
                    // cập nhật dữ liệu
                    $('#btn-save').on('click', function () {
                        const dataToSend = collectKNLData();
                        //console.log(dataToSend);
                        $.ajax({
                            url: '/FPosition/UpdateKNL',
                            type: 'POST',
                            contentType: 'application/json',
                            data: JSON.stringify(dataToSend),
                            success: function (res) {
                                alert('Cập nhật thành công!');
                                loadData();
                            },
                            error: function (err) {
                                alert('Lỗi khi cập nhật!');
                                loadData();
                                console.error(err);
                            }
                        });
                    });
                    // Gán sự kiện xóa
                    $(document).on('click', '.btn-delete-knl', function () {
                        const id = $(this).data('id');
                        const row = $('#row_' + id);

                        if (confirm('Bạn có chắc chắn muốn xóa năng lực này?')) {
                            $.ajax({
                                url: '/FPosition/DeleteKNL', // Controller xử lý
                                type: 'POST',
                                data: { id: id },
                                success: function (res) {
                                    if (res.success) {
                                        alert('Xóa dữ liệu thành công.');
                                        row.remove(); // Xóa khỏi UI
                                    } else {
                                        alert('Không thể xóa.');
                                    }
                                },
                                error: function () {
                                    alert('Đã xảy ra lỗi khi xóa.');
                                }
                            });
                        }
                    });

                    // Gán sự kiện xóa loại NL
                    $(document).on('click', '.btn-delete-loaiKNL', function () {
                        const id = $(this).data('id');
                        const row = $('#nhom_' + id);
                        const classNL  = $('.nhom_' + id);

                        if (confirm('Bạn có chắc chắn muốn xóa năng lực này?')) {
                            $.ajax({
                                url: '/FPosition/DeleteLoaiKNL', // Controller xử lý
                                type: 'POST',
                                data: { id: id },
                                success: function (res) {
                                    if (res.success) {
                                        alert('Xóa dữ liệu thành công.');
                                        row.remove(); // Xóa khỏi UI
                                        classNL.remove();
                                    } else {
                                        alert('Không thể xóa.');
                                    }
                                },
                                error: function () {
                                    alert('Đã xảy ra lỗi khi xóa.');
                                }
                            });
                        }
                    });
                    //Thêm năng lực
                    $(document).ready(function () {
                        $(document).on('click', '.btn-add-cmon', function () {
                            const idLoai = $(this).data('idloai');
                            const $currentAddRow = $(this).closest('tr'); // dòng hiện tại có dấu cộng
                            const newRowHtml = `
                            <tr>
                                <td class="text-center">
                                    <button class="btn fa fa-trash icon_action btn-delete-newknl"></button>
                                </td>
                                <td>
                                    <textarea rows="1" class="form-control txt-tennl"
                                              data-IDLoaiNL="${idLoai}" data-idnl=""></textarea>
                                </td>
                                <td style="width:100px">
                                    <input type="number" class="form-control dinhmuc" maxlength="1" value="" />
                                </td>
                                <td class="text-center" style="width:100px">
                                    <input type="checkbox" class="danhgia" />
                                </td>
                                <td><input type="number" class="form-control font-weight-bold sapxep" value=""></td>
                            </tr>`;
                            $currentAddRow.before(newRowHtml);
                            //$(`#add-row-${idLoai}`).before(newRowHtml);
                        });
                    });

                    // Cho phép xóa dòng mới bằng nút
                    $(document).on('click', '.btn-delete-newknl', function () {
                        $(this).closest('tr').remove();
                    });
                    // thêm chuyên môn mới
                    let tempLoaiId = -1;
                    $(document).on('click', '#add-new-chuyenmon', function () {
                        var renderList = $(`<tr class="text-center" id="nhom_${tempLoaiId}">
                                         <th class="small font-weight-bold">
                                             <button class="btn fa fa-trash icon_action btn-delete-newloaiKNL" data-id="${tempLoaiId}">
                                             </button>
                                             Chuyên môn
                                         </th>
                                         <th colspan="3" class="font-weight-bold font-size-lg flexible-wrap">
                                             <input type="text" class="form-control font-weight-bold txt-tennhomnl" data-idloai="${tempLoaiId}">
                                         </th>
                                         <td style="width:100px" class="text-center">
                                             <input type="number" class="form-control font-weight-bold sapxep">
                                         </td>
                                     </tr>
                                      <tr>
                                      <th colspan='1'></th>
                                      <th colspan='3' class='font-weight-bold font-size-lg'><button type='button' class='btn btn-light border border-white btn-add-cmon' data-idloai="${tempLoaiId}"><i class='fas fa-plus'></i></button>
                                      </th></tr>`);
                        $("#cmon").before(renderList);
                        tempLoaiId--;
                    });
                </script>
            </div>
        </div>



    </div>




    <div class="app-wrapper-footer">
        <div class="app-footer">
            <div class="app-footer__inner">
            </div>
        </div>
    </div>


</div>

@*<script src="~/Content/Chonse/chosen.jquery.js"></script>*@
<script src="~/Content/Chonse/chosen.jquery.js"></script>
<script src="~/Content/Chonse/chosen.jquery.js"></script>
<script type="text/javascript">
    $('#btn-add').click(function () {
        var url = $('#myModal').data('url');
        $.get(url, function (data) {
            $("#myModal").html(data);
            $("#ModalTitle").html("Thêm mới năng lực");
            $("#myModal").modal('show');
        });
    });

    $('#btn-Import').click(function () {
        var url = $('#myModalimport').data('url');
        $.get(url, function (data) {
            $("#myModal").html(data);
            $("#ModalTitle").html("Thêm mới danh sách năng lực");
            $("#myModal").modal('show');
        });
    });
    $("#IDPB").chosen({
        width: "100%"
    });
    $("#btn-search").on('click', function () {
        window.location.href = '@Url.Action("Index", "DSachDGia")?IDPB=' + $('#IDPB').val();
    });
</script>

<style>
    .chosen-container-single .chosen-single {
         color: #495057;
         background: #fff;
         background-color: #fff;
         background-clip: padding-box;
         border: 1px solid #ced4da;
         border-radius: .25rem;
         transition: border-color .15s ease-in-out,box-shadow .15s ease-in-out;
         font-size: 1rem;
         font-weight: 400;
         line-height: 1.8;
         text-transform: capitalize;
     }

     .chosen-container-single .chosen-single span {
         text-transform: capitalize !important;
         font-size: 16px !important;
     }
</style>


