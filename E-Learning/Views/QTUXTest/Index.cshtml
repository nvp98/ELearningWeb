@{
    ViewBag.Title = "Danh Sách Bài Thi";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@using E_Learning.Models
@model PagedList.IPagedList<NoiQuyUXKQView>
@using PagedList.Mvc
<link href="~/Content/assets/css/PagedList.css" rel="stylesheet" />

<div class="app-main__outer">
    <div class="app-main__inner">
        <div class="app-page-title">
            <div class="page-title-wrapper">
                <div class="page-title-heading">
                    <div class="page-title-icon">
                        <i class="pe-7s-note2 icon-gradient bg-grow-early"></i>
                    </div>
                    <div>
                        Danh Sách Bài Thi Quy Tắc Ứng Xử
                        <div class="page-title-subheading"></div>
                    </div>
                </div>
            </div>
        </div>

        <div class="tab-content">
            <div class="row">
                <div class="card col-lg-12">
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table table-bordered table-hover" width="100%">
                                <thead class="thead-light">
                                    <tr>
                                        <th class="text-center" width="30px">STT</th>
                                        <th class="text-center">Thao tác</th>
                                        <th class="text-center">Mã Nội Dung</th>
                                        <th class="">Nội Dung</th>
                                        <th class="text-center">Tên Đề Thi</th>
                                        <th class="text-center">Số Lần Thi</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @{
                                        int pageno = (int)Model.PageNumber;
                                        int itemperpage = (int)Model.PageSize;
                                        int RowNo = ((pageno - 1) * itemperpage) + 1;
                                    }
                                    @foreach (var item in Model)
                                    {
                                        <tr>
                                            <td class="text-center">@RowNo@{RowNo++;}</td>
                                            <td class="text-center">
                                                <a class="fas fa-pencil icon_action" title="Làm bài thi" href="@Url.Action("PrepareTest", "QTUXTest", new { deThiID = item.IDDeThi })">Làm bài thi</a>
                                            </td>
                                            <td class="text-center">@item.MaND</td>
                                            <td>@item.NoiDung</td>
                                            <td class="text-center">@item.TenDeThi</td>
                                            <td class="text-center">@item.LanThi lần</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                        <div class="pager float-right">
                            @Html.PagedListPager(Model, page => Url.Action("Index", "QTUXTest", new { page }))
                            <span class="pageoff">Trang @(Model.PageCount < Model.PageNumber ? 0 : Model.PageNumber) / @Model.PageCount</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="app-wrapper-footer">
        <div class="app-footer">
            <div class="app-footer__inner"></div>
        </div>
    </div>
</div>
