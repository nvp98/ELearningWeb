
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<link href="~/Content/assets/css/PagedList.css" rel="stylesheet" />

<div class="app-main__outer">
    <div class="app-main__inner">

        <div class="app-page-title">
            <div class="page-title-wrapper">
                <div class="page-title-heading">
                    <div class="page-title-icon">
                        <i class="pe-7s-id icon-gradient bg-grow-early">
                        </i>
                    </div>
                    <div>
                        Bảng Mô tả công việc
                        <div class="page-title-subheading">
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="tab-content">
            @if (ViewBag.DaLamBai)
            {
                <div id="stepDone" class="alert alert-success text-center">
                    <h5>Bạn đã hoàn thành bài kiểm tra!</h5>
                    <p>Bài làm của bạn đã được gửi đến cấp quản lý để chấm điểm.</p>
                    <a href="@Url.Action("LamBaiKiemTra", "MoTaCongViec")">
                        <i class="bi bi-journal-text"></i>Xem lại bài làm.
                    </a>
                </div>
            }
            else
            {
                <div id="stepUndone" class="alert alert-danger text-center">
                    <h5>Bạn chưa làm bài kiểm tra!</h5>
                    <a href="@Url.Action("LamBaiKiemTra", "MoTaCongViec")">
                        <i class="bi bi-journal-text"></i>Làm bài kiểm tra
                    </a>
                </div>
            }

        </div>
    </div>

    <div class="app-wrapper-footer">
        <div class="app-footer">
            <div class="app-footer__inner">
            </div>
        </div>
    </div>

</div>