
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<link href="~/Content/assets/css/PagedList.css" rel="stylesheet" />

@model E_Learning.ModelsBangMTCV.KetQuaBaiLamViewModel

@if (TempData["msgSuccess"] != null)
{
    @Html.Raw(TempData["msgSuccess"])
}
@if (TempData["msgError"] != null)
{
    @Html.Raw(TempData["msgError"])
}

<style>
    body {
        background: #f8f9fa;
    }

    table {
        background: #fff;
    }

    th {
        vertical-align: middle !important;
    }

    td {
        vertical-align: top !important;
    }

    .table thead th {
        background-color: #1d4c90;
        color: white;
    }

    textarea.form-control {
        min-height: 70px;
        resize: vertical;
    }

    .score-input {
        width: 80px;
        text-align: center;
    }

    .sticky-top {
        position: sticky;
        top: 0;
        background-color: #0d6efd;
    }
</style>

<div class="app-main__outer">
    <div class="app-main__inner">

        <div class="app-page-title">
            <div class="page-title-wrapper">
                <div class="page-title-heading">
                    <div class="page-title-icon">
                        <i class="pe-7s-id icon-gradient bg-grow-early">
                        </i>
                    </div>
                    <div>
                        Bảng Mô tả công việc - Kết quả bài kiểm tra
                        <div class="page-title-subheading">
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="tab-content">
            @if (ViewBag.CoDuLieuLamBai == false)
            {
                <h3 class="text-center text-danger">Không có dữ liệu</h3>
            }
            else
            {
                <h3><i class="bi bi-journal-text"></i>@Model.TenDe</h3>
                <p class="text-muted">Ngày làm bài: @Model.NgayLam.ToString("dd/MM/yyyy HH:mm:ss")</p>
                <p class="text-muted">
                    Tổng điểm: <span class="fw-bold text-success">@Model.TongDiem.ToString("0.##")</span>
                </p>

                <div class="table-responsive">
                    <table class="table table-bordered align-middle">
                        <thead class="sticky-top">
                            <tr>
                                <th style="width:5%">#</th>
                                <th>Câu hỏi</th>
                                <th>Câu trả lời</th>
                                <th class="text-center" style="width:10%">Kết quả</th>
                                <th class="text-center" style="width:10%">Điểm</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.ChiTietList != null && Model.ChiTietList.Count > 0)
                            {
                                int i = 1;
                                foreach (var item in Model.ChiTietList)
                                {
                                    <tr>
                                        <td>@i</td>
                                        <td>@item.CauHoi</td>
                                        <td>@item.CauTraLoi</td>
                                        <td class="text-center">
                                            @if (item.LaTracNghiem)
                                            {
                                                <span class="badge @(item.DungSai ? "bg-success" : "bg-danger")">
                                                    @(item.DungSai ? "Đúng" : "Sai")
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="text-secondary">Tự luận</span>
                                            }
                                        </td>
                                        <td class="text-center">
                                            @(item.Diem.HasValue ? item.Diem.Value.ToString("0.##") : "-")
                                        </td>
                                    </tr>
                                    i++;
                                }
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    <div class="app-wrapper-footer">
        <div class="app-footer">
            <div class="app-footer__inner">
            </div>
        </div>
    </div>
</div>