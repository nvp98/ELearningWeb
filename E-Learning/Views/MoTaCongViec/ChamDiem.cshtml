
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<link href="~/Content/assets/css/PagedList.css" rel="stylesheet" />
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

@model List<E_Learning.ModelsBangMTCV.ChamDiemViewModel>

<style>
    body {
        background: #f8f9fa;
    }

    table {
        background: #fff;
    }

    th {
        vertical-align: middle !important;
    }

    td {
        vertical-align: top !important;
    }

    .table thead th {
        background-color: #1d4c90;
        color: white;
    }

    textarea.form-control {
        min-height: 70px;
        resize: vertical;
    }

    .score-input {
        width: 80px;
        text-align: center;
    }

    .sticky-top {
        position: sticky;
        top: 0;
        background-color: #0d6efd;
    }
</style>

<div class="app-main__outer">
    <div class="app-main__inner">

        <div class="app-page-title">
            <div class="page-title-wrapper">
                <div class="page-title-heading">
                    <div class="page-title-icon">
                        <i class="pe-7s-id icon-gradient bg-grow-early">
                        </i>
                    </div>
                    <div>
                        Bảng Mô tả công việc - Đánh giá bài kiểm tra
                        <div class="page-title-subheading">
                        </div>
                    </div>
                </div>

            </div>
        </div>

        <div class="tab-content">
            <div class="table-responsive">
                @if (!Model.Any())
                {
                    <h3 class="text-center text-danger">Không có dữ liệu</h3>
                }
                else
                {
                    <table class="table table-bordered align-middle" id="tblChamDiem">
                        <thead class="sticky-top">
                            <tr class="text-center">
                                <th style="width: 5%">#</th>
                                <th style="width: 15%">Tên nhân viên</th>
                                <th style="width: 15%">Vị trí công việc</th>
                                <th style="width: 10%">Số câu đúng trắc nghiệm</th>
                                <th style="width: 25%">Câu hỏi tự luận</th>
                                <th style="width: 25%">Câu trả lời</th>
                                <th style="width: 15%">Điểm</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                int stt = 1;
                                foreach (var hv in Model)
                                {
                                    var rowSpan = hv.CauHoiTuLuan.Count == 0 ? 1 : hv.CauHoiTuLuan.Count;

                                    if (hv.CauHoiTuLuan.Count == 0)
                                    {
                                        <tr>
                                            <td class="text-center">@stt</td>
                                            <td><strong>@hv.HoTen</strong><br><small>@hv.MaNhanVien</small></td>
                                            <td class="text-center">@hv.ViTriCongViec</td>
                                            <td class="text-center">@hv.KetQuaTracNghiem</td>
                                            <td colspan="3" class="text-center text-muted">Không có câu hỏi tự luận</td>
                                        </tr>
                                        stt++;
                                        continue;
                                    }

                                    for (int i = 0; i < hv.CauHoiTuLuan.Count; i++)
                                    {
                                        var tl = hv.CauHoiTuLuan[i];
                                        <tr>
                                            @if (i == 0)
                                            {
                                                <td class="text-center" rowspan="@rowSpan">@stt</td>
                                                <td rowspan="@rowSpan">
                                                    <strong>@hv.HoTen</strong><br>
                                                    <small class="text-muted">@hv.MaNhanVien</small>
                                                </td>
                                                <td class="text-center" rowspan="@rowSpan">@hv.ViTriCongViec</td>
                                                <td class="text-center" rowspan="@rowSpan">@hv.KetQuaTracNghiem</td>
                                            }
                                            <td>@tl.CauHoi</td>
                                            <td>@tl.CauTraLoi</td>
                                            <td>
                                                <input type="number"
                                                       class="text-center form-control diem-input"
                                                       data-nhanvienid="@hv.NhanVienID"
                                                       data-cauhoi="@i"
                                                       min="0" max="10" step="0.5"
                                                       value="@(tl.Diem.HasValue ? tl.Diem.Value.ToString("0.##") : "")" />
                                            </td>
                                        </tr>
                                    }
                                    stt++;
                                }
                            }
                        </tbody>
                    </table>
                }

            </div>
            @if (Model.Any())
            {
                <div class="text-center mt-4">
                    <button id="btnSaveAll" class="btn btn-success px-4">
                        <i class="bi bi-save"></i> Lưu kết quả chấm điểm
                    </button>
                </div>
            }
        </div>
    </div>

    <div class="app-wrapper-footer">
        <div class="app-footer">
            <div class="app-footer__inner">
            </div>
        </div>
    </div>

</div>

<script>
$(document).ready(function () {
    $("#btnSaveAll").click(function () {
        let data = [];

        $(".diem-input").each(function () {
            const nhanVienID = $(this).data("nhanvienid");
            const diem = parseFloat($(this).val());
            const cauHoiIndex = $(this).data("cauhoi");

            if (!isNaN(diem)) {
                data.push({
                    NhanVienID: nhanVienID,
                    CauHoiIndex: cauHoiIndex,
                    Diem: diem
                });
            }
        });

        if (data.length === 0) {
            alert("Chưa nhập điểm cho bất kỳ bài làm nào!");
            return;
        }

        $.ajax({
            url: '@Url.Action("LuuKetQuaChamDiem", "MoTaCongViec")',
            type: "POST",
            data: JSON.stringify(data),
            contentType: "application/json; charset=utf-8",
            success: function (res) {
                if (res.success) {
                    alert("Đã lưu kết quả chấm điểm thành công!");
                    location.reload();
                } else {
                    alert("Lỗi: " + res.message);
                }
            },
            error: function (err) {
                alert("Có lỗi xảy ra khi lưu dữ liệu!");
                console.error(err);
            }
        });
    });
});
</script>
