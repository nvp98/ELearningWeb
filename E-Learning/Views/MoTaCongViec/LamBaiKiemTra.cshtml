
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<link href="~/Content/assets/css/PagedList.css" rel="stylesheet" />

@using E_Learning.ModelsBangMTCV

@if (TempData["msgSuccess"] != null)
{
    @Html.Raw(TempData["msgSuccess"])
}
@if (TempData["msgError"] != null)
{
    @Html.Raw(TempData["msgError"])
}

<div class="app-main__outer">
    <div class="app-main__inner">

        <div class="app-page-title">
            <div class="page-title-wrapper">
                <div class="page-title-heading">
                    <div class="page-title-icon">
                        <i class="pe-7s-id icon-gradient bg-grow-early">
                        </i>
                    </div>
                    <div>
                        Bảng Mô tả công việc
                        <div class="page-title-subheading">
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="tab-content">
            <div id="stepExam" class="card shadow-sm mb-4">
                @if (ViewBag.NgayDenHan != null)
                {
                    <strong class="bg-light text-danger">Hạn nộp bài: @(((DateTime)ViewBag.NgayDenHan).ToString("dd/MM/yyyy"))</strong>
                }

                @if (ViewBag.HetHan == true && ViewBag.DaLamBai == false)
                {
                    <div class="alert alert-danger text-center">
                        <h5>Đã qua thời hạn làm bài.</h5>
                    </div>
                }
                else
                {
                    <div class="card-header bg-secondary text-white d-flex justify-content-between align-items-center">
                        <strong>Làm bài kiểm tra</strong>
                    </div>
                    <div class="card-body">
                        @using (Html.BeginForm("NopBai", "MoTaCongViec", FormMethod.Post))
                        {
                            @Html.Hidden("deKiemTraID", (int)ViewBag.DeKiemTraID)
                            int stt = 1;
                            foreach (var q in Model)
                            {
                                <div class="question mb-4">
                                    <label class="form-label fw-bold">@stt. @q.NoiDung</label>

                                    @if (q.LoaiCauHoi == "TracNghiem")
                                    {
                                        var luaChonList = q.LuaChonList ?? new List<LuaChonModel>();

                                        if (luaChonList != null && luaChonList.Count > 0)
                                        {
                                            foreach (var option in luaChonList)
                                            {
                                                bool daChon = (ViewBag.DaLamBai && q.CauTraLoi == option.LuaChonID.ToString());
                                                <div class="form-check">
                                                    <input class="form-check-input" type="radio"
                                                           name="q_@q.CauHoiID"
                                                           value="@option.LuaChonID"
                                                           @(daChon ? "checked disabled" : (ViewBag.DaLamBai ? "disabled" : "")) />
                                                    <label class="form-check-label">@option.NoiDung</label>
                                                </div>
                                            }
                                        }
                                    }
                                    else if (q.LoaiCauHoi == "TuLuan")
                                    {
                                        <textarea name="essay_@q.CauHoiID"
                                                  class="form-control mt-2"
                                                  rows="3"
                                                  placeholder="Nhập câu trả lời..."
                                                  @(ViewBag.DaLamBai ? "readonly" : "")>@(q.CauTraLoi)</textarea>
                                    }
                                </div>
                                stt++;
                            }

                            if (!ViewBag.DaLamBai)
                            {
                                <div class="mb-3">
                                    <label for="nguoiChamID" class="form-label fw-bold text-danger">Chọn người quản lý để chấm điểm</label>
                                    <select class="form-control" id="nguoiChamID" name="nguoiChamID" required>
                                        <option value="">-- Chọn người đánh giá --</option>
                                        @foreach (var nv in ViewBag.DanhSachQuanLy as List<SelectListItem>)
                                        {
                                            <option value="@nv.Value">@nv.Text</option>
                                        }
                                    </select>
                                </div>

                                <div class="text-center">
                                    <button type="submit" id="btnSubmitExam" class="btn btn-success btn-lg">
                                        <i class="bi bi-send"></i> Nộp bài kiểm tra
                                    </button>
                                </div>
                            }
                            else
                            {
                                <div class="alert alert-info text-center">
                                    <i class="bi bi-check-circle"></i> Bạn đã hoàn thành bài kiểm tra này.
                                </div>
                            }
                        }
                    </div>
                }
            </div>
        </div>

    </div>

    <div class="app-wrapper-footer">
        <div class="app-footer">
            <div class="app-footer__inner">
            </div>
        </div>
    </div>
</div>
<script>
    document.getElementById("btnSubmitExam")?.addEventListener("click", function (e) {
        if (!confirm("Xác nhận nộp bài kiểm tra? Sau khi nộp sẽ không thể làm lại.")) {
            e.preventDefault();
        }
    });
</script>

<script src="~/Content/assets/Chonse/chosen.jquery.js"></script>
<link href="~/Content/assets/Chonse/chosen.css" rel="stylesheet" />
<script type="text/javascript">

    $("#nguoiChamID").chosen({
        width: "100%"
    });

</script>