
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<link href="~/Content/assets/css/PagedList.css" rel="stylesheet" />
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

@model E_Learning.ModelsBangMTCV.DeKiemTraModel

<div class="app-main__outer">
    <div class="app-main__inner">

        <div class="app-page-title">
            <div class="page-title-wrapper">
                <div class="page-title-heading">
                    <div class="page-title-icon">
                        <i class="pe-7s-id icon-gradient bg-grow-early">
                        </i>
                    </div>
                    <div>
                        Bảng Mô tả công việc
                        <div class="page-title-subheading">
                        </div>
                    </div>
                </div>

            </div>
        </div>

        <div class="tab-content">
            <h3><i class="bi bi-journal-text"></i> Chi tiết đề kiểm tra: @Model.TenDe</h3>
            <p class="text-muted">Ngày tạo: @Model.NgayTao</p>
            <div class="d-flex align-items-center mb-3">
                <label class="me-2 fw-bold text-muted">Ngày đến hạn: </label>
                <input type="date" id="ngayDenHan" class="form-control form-control-sm w-auto me-2"
                       value="@(Model.NgayDenHan.HasValue ? Model.NgayDenHan.Value.ToString("yyyy-MM-dd") : "")" />
                <button id="btnCapNhatNgayDenHan" class="btn btn-primary btn-sm">Cập nhật</button>
            </div>

            @if (Model.LaDeChinhThuc)
            {
                <div class="alert alert-success">Đây là đề chính thức hiện tại.</div>
            }
            else
            {
                <form method="post" action="@Url.Action("DatLamDeChinhThuc", "MoTaCongViec", new { id = Model.ID })" onsubmit="return confirm('Xác nhận đặt làm đề chính thức?')">
                    <button type="submit" class="btn btn-primary mb-3">
                        <i class="bi bi-check-circle"></i> Đặt làm đề chính thức
                    </button>
                </form>
            }

            <div class="card shadow-sm">
                <div class="card-body">
                    <h5 class="fw-bold mb-3">Danh sách câu hỏi</h5>

                    @{
                        int stt = 1;
                        foreach (var q in Model.CauHoiList)
                        {
                            <div class="mb-4 border-bottom pb-3">
                                <p>
                                    <strong>@stt. @q.NoiDung</strong>
                                </p>

                                @if (q.LoaiCauHoi == "TracNghiem")
                                {
                                    foreach (var opt in q.LuaChonList)
                                    {
                                        <div class="form-check">
                                            <input class="form-check-input" type="radio" disabled
                                                   @(opt.LaDapAnDung ? "checked" : "") />
                                            <label class="form-check-label">
                                                @opt.NoiDung
                                                @if (opt.LaDapAnDung)
                                                {
                                                    <span class="text-success fw-bold">(Đáp án đúng)</span>
                                                }
                                            </label>
                                        </div>
                                    }
                                }
                                else
                                {
                                    <p class="fst-italic text-muted">Câu hỏi tự luận — học viên nhập câu trả lời bằng tay.</p>
                                }
                            </div>

                            stt++;
                        }
                    }
                </div>
            </div>

            <a href="@Url.Action("DanhSachDe", "MoTaCongViec")" class="btn btn-secondary mt-3">
                <i class="bi bi-arrow-left"></i> Quay lại danh sách
            </a>

        </div>
    </div>

    <div class="app-wrapper-footer">
        <div class="app-footer">
            <div class="app-footer__inner">
            </div>
        </div>
    </div>

</div>
<script>
        $(document).ready(function () {
            $('#btnCapNhatNgayDenHan').click(function () {
                const id = @Model.ID;
                const ngayDenHan = $('#ngayDenHan').val();

                if (!ngayDenHan) {
                    alert('Vui lòng chọn ngày đến hạn.');
                    return;
                }

                $.ajax({
                    url: '@Url.Action("CapNhatNgayDenHan", "MotaCongViec")',
                    type: 'POST',
                    data: { id: id, ngayDenHan: ngayDenHan },
                    success: function (res) {
                        if (res.success) {
                            $('#msgCapNhat').text(res.message).removeClass('text-danger').addClass('text-success');
                            alert(res.message);
                        } else {
                            $('#msgCapNhat').text(res.message).removeClass('text-success').addClass('text-danger');
                        }
                    },
                    error: function () {
                        alert('Đã xảy ra lỗi khi cập nhật.');
                    }
                });
            });
        });
</script>