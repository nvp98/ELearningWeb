@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_LayoutDMST.cshtml";
}

@model E_Learning.ModelsDMST.DeTaiDMSTView

<link href="~/Content/assets/css/PagedList.css" rel="stylesheet" />
<script src="~/Content/assets/Chonse/chosen.jquery.js"></script>
<link href="~/Content/assets/Chonse/chosen.css" rel="stylesheet" />
<link href="~/Content/PagedList.css" rel="stylesheet" />
<script src="~/Content/bootstrap.bundle.min.js"></script>
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

<script src="~/Content/assets/TinyMCE/tinimceConfig.js"></script>
<style>
    .noti,
    .btnnoti {
        display: none;
    }

    a {
        text-decoration: none;
    }

    body {
        background-color: #f8f9fa;
    }

    .navbar {
        margin-bottom: 20px;
    }

    .badge {
        display: inline-block;
        padding: 0.35em 0.65em;
        font-size: 0.9rem;
        font-weight: 500;
        border-radius: 0.25rem;
        color: #fff;
    }

    .badge-warning {
        background-color: #ffc107;
    }

    .badge-info {
        background-color: #17a2b8;
    }

    .badge-success {
        background-color: #28a745;
    }

    .form-section {
        max-width: 800px;
        margin: auto;
    }

    .card {
        box-shadow: 0 2px 6px rgba(0,0,0,0.1);
    }

    .pagination .page-item.active .page-link {
        background-color: #007bff;
        border-color: #007bff;
        color: white;
    }

    .pagination .page-link {
        cursor: pointer;
    }
</style>
@if (TempData["msgSuccess"] != null)
{
    @Html.Raw(TempData["msgSuccess"])
}
@if (TempData["msgError"] != null)
{
    @Html.Raw(TempData["msgError"])
}

<body>
    <div class="app-main__outer">
        <div class="app-main__inner">
            <div class="tab-content pt-3">
                <div class="row">
                    <nav class="navbar navbar-expand-lg navbar-dark bg-primary">
                        <div class="container-fluid">
                            <a class="navbar-brand fw-bold" href="#">Cổng thông tin đổi mới sáng tạo</a>
                        </div>
                    </nav>

                    <div class="container">
                        <ul class="nav nav-tabs mb-3" id="mainTab" role="tablist">
                            <li class="nav-item">
                                <a class="nav-link active" data-bs-toggle="tab" href="#dangky" role="tab">Đăng ký đề tài</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" data-bs-toggle="tab" href="#danhsach" role="tab">Danh sách đề tài</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" data-bs-toggle="tab" href="#detaicuatoi" role="tab">Đề tài của tôi</a>
                            </li>
                        </ul>

                        <div class="tab-content">
                            <div class="tab-pane fade show active" id="dangky" role="tabpanel">
                                <div class="card p-4 form-section">
                                    <h5 class="mb-3">Đăng ký đề tài Đổi mới sáng tạo</h5>
                                    @using (Html.BeginForm("Create", "RenewCreative", FormMethod.Post, new { enctype = "multipart/form-data" }))
                                    {
                                        @Html.AntiForgeryToken()
                                        <div class="mb-3">
                                            <label class="form-label d-block fw-bold">Tên đề tài</label>
                                            @Html.TextBoxFor(m => m.TenDeTai, new { @class = "form-control", required = "required" })
                                            @Html.ValidationMessageFor(m => m.TenDeTai, "", new { @class = "text-danger" })
                                        </div>

                                        <div class="mb-3">
                                            <label class="form-label fw-bold">Lĩnh vực</label>
                                            <div id="linhVucGroup" class="d-flex flex-wrap gap-3">
                                                @foreach (var item in Model.LinhVucList)
                                                {
                                                    <div class="form-check">
                                                        @Html.RadioButtonFor(m => m.LinhVucID, item.Value,
                                                            new { @class = "form-check-input", id = "lv_" + item.Value, required = "required" })
                                                        <label class="form-check-label" for="@("lv_" + item.Value)">
                                                            @item.Text
                                                        </label>
                                                    </div>
                                                }
                                            </div>
                                        </div>

                                        <div class="mb-3">
                                            <label class="form-label d-block fw-bold">Phạm vi áp dụng</label>
                                            <div class="form-check form-check-inline">
                                                @Html.RadioButtonFor(m => m.PhamViApDung, 1, new { @class = "form-check-input", id = "pvNoiBo" })
                                                <label class="form-check-label" for="pvNoiBo">Nội bộ đơn vị</label>
                                            </div>
                                            <div class="form-check form-check-inline">
                                                @Html.RadioButtonFor(m => m.PhamViApDung, 2, new { @class = "form-check-input", id = "pvNhieu" })
                                                <label class="form-check-label" for="pvNhieu">Nhiều đơn vị</label>
                                            </div>
                                            <div class="form-check form-check-inline">
                                                @Html.RadioButtonFor(m => m.PhamViApDung, 3, new { @class = "form-check-input", id = "pvToan" })
                                                <label class="form-check-label" for="pvToan">Toàn công ty</label>
                                            </div>
                                        </div>

                                        <div class="mb-3" id="donViSelectDiv">
                                            @Html.DropDownListFor(m => m.PhongBanApDungIDs,
                                                new SelectList(Model.PhongBanList, "Value", "Text"),
                                                "-- Chọn đơn vị --",
                                                new { @class = "form-select", id = "donViSelect", required = "required" })
                                        </div>

                                        <div class="mb-3 d-none" id="selectedUnitsDiv">
                                            <ul class="list-group" id="selectedUnits"></ul>
                                        </div>

                                        <div class="mb-3">
                                            <label class="form-label fw-bold">Các bộ phận tham gia đề tài</label>
                                            @Html.ListBoxFor(m => m.PhongBanThamGiaIDs, Model.PhongBanList,
                                                new { @class = "form-select", id = "boPhan", multiple = "multiple", required = "required" })
                                        </div>

                                        <div class="mb-3 d-none" id="selectedBoPhanDiv">
                                            <ul class="list-group" id="selectedBoPhan"></ul>
                                        </div>

                                        <div class="mb-3">
                                            <label class="form-label d-block fw-bold">Mô tả ngắn</label>
                                            @Html.TextAreaFor(m => m.MoTaNgan, new { @class = "form-control", rows = "3", id = "moTa" })
                                        </div>

                                        <div class="mb-3">
                                            <label for="fileDinhKem" class="form-label fw-bold">File đính kèm</label>
                                            <input class="form-control" type="file" name="TepDinhKem" id="fileDinhKem" multiple />
                                        </div>

                                        <div class="mb-3">
                                            <label class="form-label fw-bold">Người đăng ký</label>
                                            <input type="text" class="form-control" value="@ViewBag.Username" readonly />
                                            @Html.HiddenFor(m => m.NguoiDangKyID)
                                        </div>

                                        <button type="submit" class="btn btn-primary">Đăng ký &amp; Trình ký</button>
                                    }
                                </div>
                            </div>

                            <div class="tab-pane fade" id="danhsach" role="tabpanel">
                                <div class="d-flex justify-content-between mb-3">
                                    <input type="text" class="form-control w-50" id="searchInput" placeholder="Tìm kiếm theo tên đề tài...">
                                    <button id="btnSearch" class="btn btn-primary">Tìm kiếm</button>
                                </div>

                                <table class="table table-bordered table-striped align-middle" id="tblDeTai">
                                    <thead class="table-light">
                                        <tr>
                                            <th>#</th>
                                            <th>Tên đề tài</th>
                                            <th>Bộ phận tham gia</th>
                                            <th>Phạm vi áp dụng</th>
                                            <th>File đính kèm</th>
                                            <th>Trạng thái</th>
                                        </tr>
                                    </thead>
                                    <tbody id="deTaiBody"></tbody>
                                </table>

                                <nav class="mt-3">
                                    <ul class="pagination justify-content-center" id="pagination"></ul>
                                </nav>

                            </div>

                            <div class="tab-pane fade" id="detaicuatoi" role="tabpanel">
                                <table class="table table-bordered table-striped align-middle" id="tblDeTaiCuaToi">
                                    <thead class="table-light">
                                        <tr>
                                            <th>#</th>
                                            <th>Tên đề tài</th>
                                            <th>Trạng thái</th>
                                        </tr>
                                    </thead>
                                    <tbody id="deTaiCuaToiBody"></tbody>
                                </table>
                            </div>

                        </div>
                    </div>

                    <script>
                        let currentKeyword = "";
                        let currentTrangThai = "";

                        function loadDanhSachPage(page) {
                            $.ajax({
                                url: '@Url.Action("GetDanhSachDeTaiJson")',
                                type: 'GET',
                                data: {
                                    page: page,
                                    keyword: currentKeyword,
                                    trangThai: currentTrangThai
                                },
                                success: function (res) {
                                    let tbody = $("#tblDeTai tbody");
                                    tbody.empty();

                                    if (res.Data && res.Data.length > 0) {
                                        $.each(res.Data, function (i, item) {
                                            let trangThaiText = "", trangThaiClass = "";
                                            switch (item.TrangThai) {
                                                case 0:
                                                    trangThaiText = "Chưa duyệt";
                                                    trangThaiClass = "badge-warning";
                                                    break;
                                                case 1:
                                                    trangThaiText = "Đang thực hiện";
                                                    trangThaiClass = "badge-info";
                                                    break;
                                                case 2:
                                                    trangThaiText = "Vinh danh";
                                                    trangThaiClass = "badge-success";
                                                    break;
                                            }

                                            let fileLink = "";
                                            if (item.TepDinhKem && item.TepDinhKem.trim() !== "") {
                                                const fileUrl = item.TepDinhKem.startsWith("/") ? item.TepDinhKem : "/" + item.TepDinhKem;
                                                fileLink = `<a href="${fileUrl}" target="_blank" download class="text-primary">Xem file</a>`;
                                            }

                                            tbody.append(`
                                                <tr>
                                                    <td>${i + 1}</td>
                                                    <td>${item.TenDeTai}</td>
                                                    <td>${item.BoPhanThamGia}</td>
                                                    <td>${item.BoPhanApDung}</td>
                                                    <td>${fileLink}</td>
                                                    <td><span class="badge ${trangThaiClass}">${trangThaiText}</span></td>
                                                </tr>
                                            `);
                                        });
                                    } else {
                                        tbody.append('<tr><td colspan="6" class="text-center">Không có dữ liệu</td></tr>');
                                    }

                                    renderPagination(res.CurrentPage, res.TotalPages);
                                },
                                error: function () {
                                    alert("Có lỗi xảy ra!");
                                }
                            });
                        }

                        function renderPagination(current, total) {
                            let $pagination = $("#pagination");
                            $pagination.empty();

                            const maxPagesToShow = 5;
                            let startPage = Math.max(1, current - Math.floor(maxPagesToShow / 2));
                            let endPage = Math.min(total, startPage + maxPagesToShow - 1);

                            if (endPage - startPage + 1 < maxPagesToShow) {
                                startPage = Math.max(1, endPage - maxPagesToShow + 1);
                            }

                            $pagination.append(`
                                <li class="page-item ${current === 1 ? 'disabled' : ''}">
                                    <button class="page-link" onclick="loadDanhSachPage(1)">«</button>
                                </li>
                            `);

                            $pagination.append(`
                                <li class="page-item ${current === 1 ? 'disabled' : ''}">
                                    <button class="page-link" onclick="loadDanhSachPage(${current - 1})">‹</button>
                                </li>
                            `);

                            if (startPage > 1) {
                                $pagination.append(`
                                    <li class="page-item disabled"><span class="page-link">...</span></li>
                                `);
                            }

                            for (let i = startPage; i <= endPage; i++) {
                                $pagination.append(`
                                    <li class="page-item ${i === current ? 'active' : ''}">
                                        <button class="page-link" onclick="loadDanhSachPage(${i})">${i}</button>
                                    </li>
                                `);
                            }

                            if (endPage < total) {
                                $pagination.append(`
                                    <li class="page-item disabled"><span class="page-link">...</span></li>
                                `);
                            }

                            $pagination.append(`
                                <li class="page-item ${current === total ? 'disabled' : ''}">
                                    <button class="page-link" onclick="loadDanhSachPage(${current + 1})">›</button>
                                </li>
                            `);

                            $pagination.append(`
                                <li class="page-item ${current === total ? 'disabled' : ''}">
                                    <button class="page-link" onclick="loadDanhSachPage(${total})">»</button>
                                </li>
                            `);
                        }

                        $("input[name='LinhVucID']").change(function () {
                            if ($("#lvKhac").is(":checked")) {
                                $("#inputLinhVucKhac").removeClass("d-none");
                            } else {
                                $("#inputLinhVucKhac").addClass("d-none").val("");
                            }
                        });

                        function updateCombo() {
                            let val = $("input[name='PhamViApDung']:checked").val();
                            let $select = $("#donViSelect");
                            let $div = $("#donViSelectDiv");
                            let $selectedDiv = $("#selectedUnitsDiv");

                            if (val === "1") {
                                $div.show();
                                $select.prop("disabled", false).prop("multiple", false).val("");
                                $selectedDiv.addClass("d-none").find("#selectedUnits").empty();
                            }
                            else if (val === "2") {
                                $div.show();
                                $select.prop("disabled", false).prop("multiple", true).val([]);
                                $selectedDiv.removeClass("d-none");
                            }
                            else if (val === "3") {
                                $div.hide();
                                $selectedDiv.addClass("d-none").find("#selectedUnits").empty();
                            }
                        }

                        $("#donViSelect").on("change", function () {
                            let $selectedUnits = $("#selectedUnits");
                            $selectedUnits.empty();

                            $("#donViSelect option:selected").each(function () {
                                $selectedUnits.append(
                                    $("<li>").addClass("list-group-item").text($(this).text())
                                );
                            });
                        });

                        $("#boPhan").on("change", function () {
                            let $selectedDiv = $("#selectedBoPhanDiv");
                            let $list = $("#selectedBoPhan");

                            $list.empty();

                            let selected = $("#boPhan option:selected");
                            $selectedDiv.removeClass("d-none");
                            selected.each(function () {
                                $list.append(
                                    $("<li>").addClass("list-group-item").text($(this).text())
                                );
                            });
                        });

                        loadDanhSachPage(1);
                        updateCombo();
                        
                        $("input[name='PhamViApDung']").on("change", updateCombo);

                        let allData = [];

                        function loadDanhSach() {
                            $.getJSON('/RenewCreative/GetDanhSachDeTaiJson', function (res) {
                                if (res.Data && res.Data.length > 0) {
                                    allData = res.Data;
                                    renderTable(allData);
                                } else {
                                    $("#deTaiBody").html('<tr><td colspan="5" class="text-center">Không có dữ liệu</td></tr>');
                                }
                            });
                        }

                        function renderTable(data) {
                            const tbody = $("#tblDeTai tbody");
                            tbody.empty();

                            $.each(data, function (i, item) {
                                let trangThaiText = "";
                                let trangThaiClass = "";

                                switch (item.TrangThai) {
                                    case 0:
                                        trangThaiText = "Chưa duyệt";
                                        trangThaiClass = "badge-warning";
                                        break;
                                    case 1:
                                        trangThaiText = "Đang thực hiện";
                                        trangThaiClass = "badge-info";
                                        break;
                                    case 2:
                                        trangThaiText = "Vinh danh";
                                        trangThaiClass = "badge-success";
                                        break;
                                }

                                let fileLink = "";
                                if (item.TepDinhKem && item.TepDinhKem.trim() !== "") {
                                    const fileUrl = item.TepDinhKem.startsWith("/") ? item.TepDinhKem : "/" + item.TepDinhKem;
                                    fileLink = `<a href="${fileUrl}" target="_blank" download class="text-primary">Xem file</a>`;
                                }

                                tbody.append(`
                                    <tr>
                                        <td>${i + 1}</td>
                                        <td>${item.TenDeTai}</td>
                                        <td>${item.BoPhanThamGia}</td>
                                        <td>${item.BoPhanApDung}</td>
                                        <td>${fileLink}</td>
                                        <td><span class="badge ${trangThaiClass}">${trangThaiText}</span></td>
                                    </tr>
                                `);
                            });
                        }

                        function filterData() {
                            currentKeyword = $("#searchInput").val();

                            loadDanhSachPage(1);
                        }

                        function loadDeTaiCuaToi() {
                            $.ajax({
                                url: '@Url.Action("GetDeTaiCuaToi")',
                                type: 'GET',
                                success: function (res) {
                                    const tbody = $("#tblDeTaiCuaToi tbody");
                                    tbody.empty();

                                    if (res.Data && res.Data.length > 0) {
                                        $.each(res.Data, function (i, item) {
                                            let trangThaiText = "";
                                            let trangThaiClass = "";

                                            switch (item.TrangThai) {
                                                case 0:
                                                    trangThaiText = "Chưa duyệt";
                                                    trangThaiClass = "badge-warning";
                                                    break;
                                                case 1:
                                                    trangThaiText = "Đang thực hiện";
                                                    trangThaiClass = "badge-info";
                                                    break;
                                                case 2:
                                                    trangThaiText = "Vinh danh";
                                                    trangThaiClass = "badge-success";
                                                    break;
                                            }

                                            tbody.append(`
                                                <tr>
                                                    <td>${i + 1}</td>
                                                    <td><a href="/RenewCreative/Edit?id=${item.ID}" class="text-primary">${item.TenDeTai}</a></td>
                                                    <td><span class="badge ${trangThaiClass}">${trangThaiText}</span></td>
                                                </tr>
                                            `);
                                        });
                                    } else {
                                        tbody.append('<tr><td colspan="3" class="text-center">Không có dữ liệu</td></tr>');
                                    }
                                },
                                error: function () {
                                    alert("Có lỗi xảy ra!");
                                }
                            });
                        }

                        $(document).ready(function () {
                            loadDanhSachPage(1);
                            loadDeTaiCuaToi();

                            $("#btnSearch").click(filterData);
                            $("#searchInput").on("keyup", function (e) {
                                if (e.key === "Enter") filterData();
                            });
                        });
                    </script>
                </div>
            </div>
        </div>
    </div>
</body>