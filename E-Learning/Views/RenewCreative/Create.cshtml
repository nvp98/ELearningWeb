@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_LayoutDMST.cshtml";
}

@model E_Learning.ModelsDMST.DeTaiDMSTView

<link href="~/Content/assets/css/PagedList.css" rel="stylesheet" />
<script src="~/Content/assets/Chonse/chosen.jquery.js"></script>
<link href="~/Content/assets/Chonse/chosen.css" rel="stylesheet" />
<link href="~/Content/PagedList.css" rel="stylesheet" />
<script src="~/Content/bootstrap.bundle.min.js"></script>
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

<script src="~/Content/assets/TinyMCE/tinimceConfig.js"></script>
<style>
    .noti,
    .btnnoti {
        display: none;
    }

    a {
        text-decoration: none;
    }

    body {
        background-color: #f8f9fa;
    }

    .navbar {
        margin-bottom: 20px;
    }

    .badge {
        font-size: 0.9rem;
    }

    .form-section {
        max-width: 800px;
        margin: auto;
    }

    .card {
        box-shadow: 0 2px 6px rgba(0,0,0,0.1);
    }
</style>
@if (TempData["msgSuccess"] != null)
{
    @Html.Raw(TempData["msgSuccess"])
}
@if (TempData["msgError"] != null)
{
    @Html.Raw(TempData["msgError"])
}

<body>
    <div class="app-main__outer">
        <div class="app-main__inner">
            <div class="tab-content pt-3">
                <div class="row">
                    <nav class="navbar navbar-expand-lg navbar-dark bg-primary">
                        <div class="container-fluid">
                            <a class="navbar-brand fw-bold" href="#">Cổng thông tin đổi mới sáng tạo</a>
                        </div>
                    </nav>

                    <div class="container">
                        <ul class="nav nav-tabs mb-3" id="mainTab" role="tablist">
                            <li class="nav-item">
                                <a class="nav-link active" data-bs-toggle="tab" href="#dangky" role="tab">Đăng ký đề tài</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" data-bs-toggle="tab" href="#danhsach" role="tab">Danh sách đề tài</a>
                            </li>
                        </ul>

                        <div class="tab-content">
                            <div class="tab-pane fade show active" id="dangky" role="tabpanel">
                                <div class="card p-4 form-section">
                                    <h5 class="mb-3">Đăng ký đề tài Đổi mới sáng tạo</h5>
                                    @using (Html.BeginForm("Create", "RenewCreative", FormMethod.Post, new { enctype = "multipart/form-data" }))
                                    {
                                        @Html.AntiForgeryToken()
                                        <div class="mb-3">
                                            <label class="form-label d-block fw-bold">Tên đề tài</label>
                                            @Html.TextBoxFor(m => m.TenDeTai, new { @class = "form-control", required = "required" })
                                            @Html.ValidationMessageFor(m => m.TenDeTai, "", new { @class = "text-danger" })
                                        </div>

                                        <div class="mb-3">
                                            <label class="form-label fw-bold">Lĩnh vực</label>
                                            <div id="linhVucGroup" class="d-flex flex-wrap gap-3">
                                                @foreach (var item in Model.LinhVucList)
                                                {
                                                    <div class="form-check">
                                                        @Html.RadioButtonFor(m => m.LinhVucID, item.Value,
                                                            new { @class = "form-check-input", id = "lv_" + item.Value })
                                                        <label class="form-check-label" for="@("lv_" + item.Value)">
                                                            @item.Text
                                                        </label>
                                                    </div>
                                                }
                                            </div>
                                        </div>

                                        <div class="mb-3">
                                            <label class="form-label d-block fw-bold">Phạm vi áp dụng</label>
                                            <div class="form-check form-check-inline">
                                                @Html.RadioButtonFor(m => m.PhamViApDung, 1, new { @class = "form-check-input", id = "pvNoiBo" })
                                                <label class="form-check-label" for="pvNoiBo">Nội bộ đơn vị</label>
                                            </div>
                                            <div class="form-check form-check-inline">
                                                @Html.RadioButtonFor(m => m.PhamViApDung, 2, new { @class = "form-check-input", id = "pvNhieu" })
                                                <label class="form-check-label" for="pvNhieu">Nhiều đơn vị</label>
                                            </div>
                                            <div class="form-check form-check-inline">
                                                @Html.RadioButtonFor(m => m.PhamViApDung, 3, new { @class = "form-check-input", id = "pvToan" })
                                                <label class="form-check-label" for="pvToan">Toàn công ty</label>
                                            </div>
                                        </div>

                                        <div class="mb-3" id="donViSelectDiv">
                                            @Html.DropDownListFor(m => m.PhongBanApDungIDs,
                                                new SelectList(Model.PhongBanList, "Value", "Text"),
                                                "-- Chọn đơn vị --",
                                                new { @class = "form-select", id = "donViSelect" })
                                        </div>

                                        <div class="mb-3 d-none" id="selectedUnitsDiv">
                                            <ul class="list-group" id="selectedUnits"></ul>
                                        </div>

                                        <div class="mb-3">
                                            <label class="form-label fw-bold">Các bộ phận tham gia đề tài</label>
                                            @Html.ListBoxFor(m => m.PhongBanThamGiaIDs, Model.PhongBanList,
                                                new { @class = "form-select", id = "boPhan", multiple = "multiple" })
                                        </div>

                                        <div class="mb-3 d-none" id="selectedBoPhanDiv">
                                            <ul class="list-group" id="selectedBoPhan"></ul>
                                        </div>

                                        <div class="mb-3">
                                            <label class="form-label d-block fw-bold">Mô tả ngắn</label>
                                            @Html.TextAreaFor(m => m.MoTaNgan, new { @class = "form-control", rows = "3", id = "moTa" })
                                        </div>

                                        <div class="mb-3">
                                            <label for="fileDinhKem" class="form-label fw-bold">File đính kèm</label>
                                            <input class="form-control" type="file" name="TepDinhKem" id="fileDinhKem" multiple />
                                        </div>

                                        <div class="mb-3">
                                            <label class="form-label fw-bold">Người đăng ký</label>
                                            <input type="text" class="form-control" value="@ViewBag.Username" readonly />
                                            @Html.HiddenFor(m => m.NguoiDangKyID)
                                        </div>

                                        <button type="submit" class="btn btn-primary">Đăng ký &amp; Trình ký</button>
                                    }
                                </div>
                            </div>

                            <div class="tab-pane fade" id="danhsach" role="tabpanel">
                                <div class="d-flex justify-content-between mb-3">
                                    <input type="text" class="form-control w-50" id="searchInput" placeholder="Tìm kiếm theo tên đề tài...">
                                    <select class="form-select w-25" id="filterTrangThai">
                                        <option value="">Tất cả trạng thái</option>
                                        <option value="chua">Chờ duyệt</option>
                                        <option value="duyet">Đã duyệt thực hiện</option>
                                        <option value="thanhcong">Đã thành công</option>
                                    </select>
                                </div>

                                <table class="table table-bordered table-striped align-middle" id="tblDeTai">
                                    <thead class="table-light">
                                        <tr>
                                            <th>#</th>
                                            <th>Tên đề tài</th>
                                            <th>Người đăng ký</th>
                                            <th>Bộ phận tham gia</th>
                                            <th>Phạm vi áp dụng</th>
                                            <th>File đính kèm</th>
                                            <th>Trạng thái</th>
                                        </tr>
                                    </thead>
                                    <tbody></tbody>
                                    @*<tbody id="tableDeTai">
                                        @foreach (var item in Model.DanhSachDeTai)
                                        {
                                            <tr>
                                                <td></td>
                                                <td>@item.TenDeTai</td>
                                                <td></td>
                                                <td>@item.BoPhanThamGia</td>
                                                <td></td>
                                                <td></td>
                                                <td>@item.TrangThai</td>
                                            </tr>
                                        }
                                    </tbody>*@
                                </table>
                            </div>
                            <nav class="mt-3">
                                <ul class="pagination justify-content-center" id="pagination"></ul>
                            </nav>
                        </div>
                    </div>

                    <script>

                        $(function () {

                            function loadDanhSach(page) {
                                $.ajax({
                                    url: '@Url.Action("GetDanhSachDeTaiJson")',
                                    type: 'GET',
                                    data: { page: page },
                                    success: function (res) {
                                        let tbody = $("#tblDeTai tbody");
                                        tbody.empty();

                                        if (res.Data && res.Data.length > 0) {
                                            $.each(res.Data, function (i, item) {
                                                let trangThai = "Khác";
                                                if (item.TrangThai === 0) trangThai = "Chưa duyệt";
                                                else if (item.TrangThai === 1) trangThai = "Đang thực hiện";
                                                else if (item.TrangThai === 2) trangThai = "Khen thưởng";

                                                tbody.append(`
                                                    <tr>
                                                        <td>${i+1}</td>
                                                        <td>${item.TenDeTai}</td>
                                                        <td></td>
                                                        <td>${item.BoPhanThamGia}</td>
                                                        <td></td>
                                                        <td></td>
                                                        <td>${trangThai}</td>
                                                    </tr>
                                                `);
                                            });
                                        } else {
                                            tbody.append('<tr><td colspan="3" class="text-center">Không có dữ liệu</td></tr>');
                                        }

                                        renderPagination(res.CurrentPage, res.TotalPages);
                                    },
                                    error: function () {
                                        alert("Có lỗi xảy ra!");
                                    }
                                });
                            }

                            function renderPagination(current, total) {
                                var $pagination = $("#pagination");
                                $pagination.empty();

                                if (total <= 0) return;

                                const isFirst = current === 1;
                                const isLast = current === total;
                                const prev = Math.max(1, current - 1);
                                const next = Math.min(total, current + 1);

                                const items = [
                                    { text: 'Trang đầu', page: 1, disabled: isFirst },
                                    { text: 'Trước', page: prev, disabled: isFirst },
                                    { text: current + ' / ' + total, page: null, disabled: true, isLabel: true },
                                    { text: 'Sau', page: next, disabled: isLast },
                                    { text: 'Trang cuối', page: total, disabled: isLast }
                                ];

                                items.forEach(function (it) {
                                    if (it.isLabel) {
                                        $pagination.append(
                                            '<li class="page-item active"><span class="page-link">' + it.text + '</span></li>'
                                        );
                                    } else {
                                        var disabledClass = it.disabled ? 'disabled' : '';
                                        var btn = $('<li class="page-item ' + disabledClass + '"><button class="page-link" type="button" data-page="' + it.page + '">' + it.text + '</button></li>');
                                        $pagination.append(btn);
                                    }
                                });

                                $pagination.find('button[data-page]').off('click').on('click', function () {
                                    var p = $(this).data('page');
                                    if (!$(this).closest('.page-item').hasClass('disabled')) {
                                        loadDanhSach(p);
                                    }
                                });
                            }

                            $("input[name='LinhVucID']").change(function () {
                                if ($("#lvKhac").is(":checked")) {
                                    $("#inputLinhVucKhac").removeClass("d-none");
                                } else {
                                    $("#inputLinhVucKhac").addClass("d-none").val("");
                                }
                            });

                            function updateCombo() {
                                let val = $("input[name='PhamViApDung']:checked").val();
                                let $select = $("#donViSelect");
                                let $div = $("#donViSelectDiv");
                                let $selectedDiv = $("#selectedUnitsDiv");

                                if (val === "1") {
                                    $div.show();
                                    $select.prop("disabled", false).prop("multiple", false).val(""); // reset rỗng
                                    $selectedDiv.addClass("d-none").find("#selectedUnits").empty();
                                }
                                else if (val === "2") {
                                    $div.show();
                                    $select.prop("disabled", false).prop("multiple", true).val([]); // reset rỗng
                                    $selectedDiv.removeClass("d-none");
                                }
                                else if (val === "3") {
                                    $div.hide();
                                    $selectedDiv.addClass("d-none").find("#selectedUnits").empty();
                                }
                            }

                            $("#donViSelect").on("change", function () {
                                let $selectedUnits = $("#selectedUnits");
                                $selectedUnits.empty();

                                $("#donViSelect option:selected").each(function () {
                                    $selectedUnits.append(
                                        $("<li>").addClass("list-group-item").text($(this).text())
                                    );
                                });
                            });

                            $("#boPhan").on("change", function () {
                                let $selectedDiv = $("#selectedBoPhanDiv");
                                let $list = $("#selectedBoPhan");

                                $list.empty();

                                let selected = $("#boPhan option:selected");
                                $selectedDiv.removeClass("d-none");
                                selected.each(function () {
                                    $list.append(
                                        $("<li>").addClass("list-group-item").text($(this).text())
                                    );
                                });
                                //if (selected.length > 0) {
                                //    $selectedDiv.removeClass("d-none");
                                //    selected.each(function () {
                                //        $list.append(
                                //            $("<li>").addClass("list-group-item").text($(this).text())
                                //        );
                                //    });
                                //} else {
                                //    //$selectedDiv.addClass("d-none");
                                //}
                            });

                            loadDanhSach(1);
                            updateCombo();
                            $("input[name='PhamViApDung']").on("change", updateCombo);
                        });

                    </script>

                    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
                </div>

            </div>
        </div>
    </div>
</body>