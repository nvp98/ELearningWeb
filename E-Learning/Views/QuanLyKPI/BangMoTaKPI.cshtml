    <div class="app-wrapper-footer">
        <div class="app-footer">
            <div class="app-footer__inner">
            </div>
        </div>
    </div>

</div>

<script>

    const labels = ['Chưa thực hiện', 'Đang thực hiện', 'Hoàn thành', 'Chờ phối hợp', 'Không áp dụng'];

    const dataCounts = [12, 18, 30, 5, 2];

    const members = ['Nguyễn Vĩnh Phước', 'Lý Thành Nam', 'Lê Thanh Sang', 'Cao Anh Dũng', 'Nguyễn Võ Tuấn Nhân'];

    const memberData = [
        [3, 5, 10, 1, 0],
        [2, 6, 8, 2, 1],
        [4, 4, 7, 1, 0],
        [1, 2, 5, 0, 0],
        [2, 1, 0, 1, 1]
    ];

    const colors = ['#FF6384', '#36A2EB', '#4BC0C0', '#FFCE56', '#9966FF'];

    const weights = [10, 20, 40, 15, 15];

    const totals = memberData.map(row => row.reduce((a, b) => a + b, 0));

    // convert data
    const datasets = labels.map((label, stateIndex) => ({
        label: label,
        data: memberData.map(row => row[stateIndex]),
        backgroundColor: colors[stateIndex],
        borderRadius: 5
    }));

    const ctxBar = document.getElementById('barChart').getContext('2d');
    new Chart(ctxBar, {
        type: 'bar',
        data: {
            labels: members,
            datasets: datasets
        },
        options: {
            indexAxis: 'y',
            responsive: true,
            plugins: {
                tooltip: {
                    callbacks: {
                        label: function (context) {
                            const index = context.dataIndex;
                            const value = context.parsed.x;
                            const percent = ((value / totals[index]) * 100).toFixed(0);
                            return `${context.dataset.label}: ${value} (${percent}%)`;
                        }
                    }
                },
                legend: {
                    position: 'bottom'
                }
            },
            scales: {
                x: {
                    stacked: true,
                    beginAtZero: true,
                    ticks: { precision: 0 }
                },
                y: {
                    stacked: true
                }
            }
        }
    });

    const ctxPie = document.getElementById('pieChart').getContext('2d');
    new Chart(ctxPie, {
        type: 'pie',
        data: {
            labels: labels.map((l, i) => `${l} (${weights[i]}%)`),
            datasets: [{
                data: dataCounts,
                backgroundColor: colors,
                borderWidth: 1
            }]
        },
        options: {
            responsive: true,
            plugins: {
                legend: {
                    position: 'bottom'
                },
                tooltip: {
                    callbacks: {
                        label: function (context) {
                            const index = context.dataIndex;
                            const label = context.label.split(' ')[0];
                            const value = context.dataset.data[index];
                            const weight = weights[index];
                            return `${label}: ${value} (Trọng số: ${weight}%)`;
                        }
                    }
                }
            }
        }
    });
</script>


