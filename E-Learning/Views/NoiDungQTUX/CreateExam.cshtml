@using (Html.BeginForm("CreateExam", "NoiDungQTUX", FormMethod.Post, new { enctype = "multipart/form-data" }))
{
    <div class="modal-body">
        <div class="form-group">
            <label>Mã Đề <span class="text-danger">*</span></label>
            <input type="text" class="form-control" name="MaDe" value="@ViewBag.MaDe" readonly />
            <input type="hidden" name="IDND" value="@ViewBag.IDND" />
        </div>

        <div class="form-group">
            <label>Tên Đề <span class="text-danger">*</span></label>
            <input type="text" class="form-control" name="TenDe" placeholder="Nhập tên đề thi" required />
        </div>

        <div class="form-group">
            <label>Điểm Chuẩn</label>
            <input type="number" class="form-control" name="DiemChuan" placeholder="5.0" value="5" step="0.1" />
        </div>

        <div class="form-group">
            <label>Thời Gian Làm Bài (phút)</label>
            <input type="number" class="form-control" name="ThoiGianLamBai" placeholder="30" value="30" />
        </div>
    </div>
    <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-dismiss="modal">Hủy</button>
        <button type="submit" class="btn btn-primary">Tạo Đề Thi</button>
    </div>
}
