@{
    ViewBag.Title = "Quản Lý Câu Hỏi";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@using PagedList.Mvc
@using E_Learning.Models
@model PagedList.IPagedList<CauHoiViewModel>
<link href="~/Content/assets/css/PagedList.css" rel="stylesheet" />

<div class="app-main__outer">
    <div class="app-main__inner">
        <div class="app-page-title">
            <div class="page-title-wrapper">
                <div class="page-title-heading">
                    <div class="page-title-icon">
                        <i class="pe-7s-note icon-gradient bg-grow-early"></i>
                    </div>
                    <div>
                        Quản Lý Câu Hỏi: @ViewBag.TenDeThi
                    </div>
                </div>
                <div class="page-title-actions">
                    <button type="button" class="btn-icon btn-icon-only btn btn-link" id="CreateQuestion" data-iddethi="@ViewBag.IDDeThi">
                        <i class="pe-7s-plus"></i> Thêm Câu Hỏi
                    </button>
                    <a href="@Url.Action("ManageExams", "NoiDungQTUX", new { IDND = ViewBag.IDND })" class="btn btn-primary">
                        <i class="pe-7s-back"></i> Quay Lại
                    </a>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-12">
                <div class="main-card mb-3 card">
                    <div class="table-responsive">
                        <table class="table table-hover table-striped mb-0">
                            <thead>
                                <tr>
                                    <th>STT</th>
                                    <th>Nội Dung Câu Hỏi</th>
                                    <th>Đáp Án Đúng</th>
                                    <th>Điểm</th>
                                    <th>Hành Động</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.Count() > 0)
                                {
                                    int stt = 1;
                                    foreach (dynamic item in Model)
                                    {
                                        string dapAnDung = item.IDDAĐung == 1 ? "A" : (item.IDDAĐung == 2 ? "B" : (item.IDDAĐung == 3 ? "C" : "D"));
                                        <tr>
                                            <td>@stt</td>
                                            <td>@item.NoiDungCauHoi</td>
                                            <td><span class="badge badge-success">@dapAnDung</span></td>
                                            <td>@item.Diem</td>
                                            <td>
                                                <button type="button" class="btn btn-sm btn-info" onclick="editQuestion(@item.IDCauHoiDeThi)">
                                                    <i class="pe-7s-pencil"></i> Sửa
                                                </button>
                                                @using (Html.BeginForm("DeleteQuestion", "NoiDungQTUX", FormMethod.Post, new { style = "display:inline;" }))
                                                {
                                                    <input type="hidden" name="IDCauHoiDeThi" value="@item.IDCauHoiDeThi" />
                                                    <input type="hidden" name="IDDeThi" value="@ViewBag.IDDeThi" />
                                                    <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Bạn có chắc chắn muốn xóa câu hỏi này?')">
                                                        <i class="pe-7s-trash"></i> Xóa
                                                    </button>
                                                }
                                            </td>
                                        </tr>
                                        stt++;
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="5" class="text-center">Chưa có câu hỏi nào</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
                <div style="text-align:center">
                    @Html.PagedListPager(Model, page => Url.Action("ManageQuestions", new { page, IDDeThi = ViewBag.IDDeThi }))
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="modalCreateQuestion" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Thêm Câu Hỏi</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div id="modalBody"></div>
        </div>
    </div>
</div>

<script>
    $(document).ready(function () {
        $('#CreateQuestion').click(function () {
            var iddethi = $(this).data('iddethi');
            $.get('@Url.Action("CreateQuestion", "NoiDungQTUX")', { IDDeThi: iddethi }, function (data) {
                $('#modalBody').html(data);
                $('#modalCreateQuestion').modal('show');
            });
        });
    });

    function editQuestion(id) {
        $.get('@Url.Action("EditQuestion", "NoiDungQTUX")', { IDCauHoiDeThi: id, IDDeThi: @ViewBag.IDDeThi }, function (data) {
            $('#modalBody').html(data);
            $('#modalCreateQuestion').modal('show');
        });
    }
</script>
